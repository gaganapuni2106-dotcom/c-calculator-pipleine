pipeline {
    agent any

    parameters {
        string(
            name: 'NUMBER',
            defaultValue: '5',
            description: 'Enter the number for factorial'
        )
    }

    stages {
        stage('Build') {
            steps {
                sh 'make'
            }
        }

        stage('Run Factorial') {
            steps {
                sh "./factorial $NUMBER"
            }
        }
    }
}
