pipeline {
    agent any

    stages {

        stage('Build') {
            steps {
                sh 'make calculator'
            }
        }

        stage('Test') {
            steps {
                sh 'make test'
            }
        }
    }

    post {
       success{
            echo 'Pipeline completed successfully!'
        }
	failure{
		echo 'pipeline failed'
	}
    }
}
