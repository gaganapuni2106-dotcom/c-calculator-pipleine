pipeline {
    agent any

    stages {

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Build') {
            steps {
                sh 'make'
            }
        }

        stage('Test') {
            steps {
                sh 'make test'
            }
        }

        stage('Run') {
            steps {
                sh './hello'
            }
        }
    }

    post {
        success {
            echo 'Hello C project pipeline completed successfully!'
        }

        failure {
            echo 'Pipeline failed!'
        }
    }
}
